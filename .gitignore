# Secrets — ne doivent JAMAIS être versionnés.
# Seul server/.env.example l'est, comme modèle.
.env
.env.*
!.env.example
server/.env
client/.env

# Dépendances : reconstruites depuis les package-lock.json, qui eux sont
# versionnés. Les versionner masquait toute modification locale d'une
# dépendance et noyait les diffs de mise à jour de sécurité.
node_modules/

# Sorties de build
dist/
build/
.vercel/

# Base MongoDB locale de développement (scripts/baseLocale.js) et binaires
# téléchargés par mongodb-memory-server : données jetables, jamais versionnées.
server/.mongo-local/
.cache/mongodb-binaries/

# Logs et fichiers temporaires
*.log
npm-debug.log*
.DS_Store
Thumbs.db
