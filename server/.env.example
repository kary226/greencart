# ==============================
# GREENCART - Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ==============================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/greencart?retryWrites=true&w=majority

# JWT
JWT_SECRET=ton_secret_jwt_tres_long_et_aleatoire

# Cloudinary (pour les images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (paiement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com
SMTP_PASS=ton_mot_de_passe_application

# GeniusPay
GENIUSPAY_API_KEY=
GENIUSPAY_WEBHOOK_SECRET=

# Divers
PORT=4000
NODE_ENV=production
